<div class="h-full flex flex-col bg-white">
  <!-- Header -->
  <div class="flex items-center justify-between px-6 py-3 border-b border-gray-200">
    <div>
      <h1 class="text-xl font-semibold text-gray-900">Maintenance History</h1>
      <p class="text-sm text-gray-500 mt-0.5">
        <%= @total_count %> records found
      </p>
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Export Dropdown -->
      <div class="relative" x-data="{ open: false }">
        <button
          @click="open = !open"
          class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50"
        >
          Export
          <svg class="inline-block w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        
        <div
          x-show="open"
          @click.away="open = false"
          x-transition
          class="absolute right-0 mt-1 w-40 bg-white rounded-md shadow-lg border border-gray-200 z-10"
        >
          <div class="py-1">
            <button
              phx-click="export"
              phx-value-format="csv"
              class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              Export as CSV
            </button>
            <button
              phx-click="export"
              phx-value-format="excel"
              class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              Export as Excel
            </button>
            <button
              phx-click="export"
              phx-value-format="pdf"
              class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              Export as PDF
            </button>
            <button
              phx-click="export"
              phx-value-format="html"
              class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              Export as HTML
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Type Tabs -->
  <div class="px-6 border-b border-gray-200">
    <nav class="flex -mb-px space-x-6">
      <button
        phx-click="filter"
        phx-value-type="all"
        class={"py-3 px-1 border-b-2 font-medium text-sm transition-colors #{if @history_type == "all", do: "border-blue-500 text-blue-600", else: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"}"}
      >
        All History
      </button>
      <button
        phx-click="filter"
        phx-value-type="pm"
        class={"py-3 px-1 border-b-2 font-medium text-sm transition-colors #{if @history_type == "pm", do: "border-blue-500 text-blue-600", else: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"}"}
      >
        PM History
      </button>
      <button
        phx-click="filter"
        phx-value-type="work_order"
        class={"py-3 px-1 border-b-2 font-medium text-sm transition-colors #{if @history_type == "work_order", do: "border-blue-500 text-blue-600", else: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"}"}
      >
        Work Order History
      </button>
    </nav>
  </div>

  <!-- Filters Bar -->
  <div class="px-6 py-3 bg-gray-50 border-b border-gray-200">
    <form phx-change="filter" phx-submit="filter">
      <div class="grid grid-cols-12 gap-3">
        <!-- Search -->
        <div class="col-span-3">
          <input
            type="text"
            name="filter[search]"
            value={@search_query}
            phx-keyup="search"
            phx-debounce="300"
            placeholder="Search..."
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <!-- Date From -->
        <div class="col-span-2">
          <input
            type="date"
            name="filter[date_from]"
            value={@filters.date_from}
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <!-- Date To -->
        <div class="col-span-2">
          <input
            type="date"
            name="filter[date_to]"
            value={@filters.date_to}
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          />
        </div>

        <!-- Equipment Filter -->
        <div class="col-span-2">
          <select
            name="filter[equipment_id]"
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          >
            <option value="">All Equipment</option>
            <%= for {name, id} <- @equipment_options do %>
              <option value={id} selected={@filters.equipment_id == id}><%= name %></option>
            <% end %>
          </select>
        </div>

        <!-- Technician Filter -->
        <div class="col-span-2">
          <select
            name="filter[technician_id]"
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          >
            <option value="">All Technicians</option>
            <%= for {name, id} <- @user_options do %>
              <option value={id} selected={@filters.technician_id == to_string(id)}><%= name %></option>
            <% end %>
          </select>
        </div>

        <!-- Status Filter -->
        <div class="col-span-1">
          <select
            name="filter[status]"
            class="w-full px-3 py-1.5 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          >
            <option value="all">All Status</option>
            <option value="completed" selected={@filters.status == "completed"}>Completed</option>
            <option value="in_progress" selected={@filters.status == "in_progress"}>In Progress</option>
            <option value="cancelled" selected={@filters.status == "cancelled"}>Cancelled</option>
          </select>
        </div>
      </div>

      <div class="flex items-center gap-2 mt-2">
        <button
          type="button"
          phx-click="reset_filters"
          class="px-3 py-1 text-xs font-medium text-gray-600 hover:text-gray-900"
        >
          Reset Filters
        </button>
        <span class="text-xs text-gray-500">
          Showing <%= (@page - 1) * @per_page + 1 %> - <%= min(@page * @per_page, @total_count) %> of <%= @total_count %>
        </span>
      </div>
    </form>
  </div>

  <!-- Table -->
  <div class="flex-1 overflow-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200 sticky top-0">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-700 cursor-pointer hover:bg-gray-100" phx-click="sort" phx-value-field="type">
            <div class="flex items-center gap-1">
              Type
              <%= if @sort_by == "type" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </th>
          <th class="px-4 py-2 text-left font-medium text-gray-700 cursor-pointer hover:bg-gray-100" phx-click="sort" phx-value-field="date">
            <div class="flex items-center gap-1">
              Date
              <%= if @sort_by == "date" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </th>
          <th class="px-4 py-2 text-left font-medium text-gray-700">Title</th>
          <th class="px-4 py-2 text-left font-medium text-gray-700 cursor-pointer hover:bg-gray-100" phx-click="sort" phx-value-field="equipment">
            <div class="flex items-center gap-1">
              Equipment
              <%= if @sort_by == "equipment" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </th>
          <th class="px-4 py-2 text-left font-medium text-gray-700 cursor-pointer hover:bg-gray-100" phx-click="sort" phx-value-field="technician">
            <div class="flex items-center gap-1">
              Technician
              <%= if @sort_by == "technician" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </th>
          <th class="px-4 py-2 text-left font-medium text-gray-700 cursor-pointer hover:bg-gray-100" phx-click="sort" phx-value-field="duration">
            <div class="flex items-center gap-1">
              Duration
              <%= if @sort_by == "duration" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </th>
          <th class="px-4 py-2 text-left font-medium text-gray-700 cursor-pointer hover:bg-gray-100" phx-click="sort" phx-value-field="status">
            <div class="flex items-center gap-1">
              Status
              <%= if @sort_by == "status" do %>
                <%= if @sort_order == "asc" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                <% end %>
              <% end %>
            </div>
          </th>
          <th class="px-4 py-2 text-center font-medium text-gray-700">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <%= for item <- @history do %>
          <tr class="hover:bg-gray-50 cursor-pointer" phx-click="view_detail" phx-value-id={item.reference_id} phx-value-type={item.type}>
            <td class="px-4 py-2">
              <span class={"inline-flex items-center px-2 py-0.5 rounded text-xs font-medium #{type_badge_color(item.type)}"}>
                <%= item.type %>
              </span>
            </td>
            <td class="px-4 py-2 text-gray-900">
              <%= format_datetime(item.date) %>
            </td>
            <td class="px-4 py-2">
              <div class="font-medium text-gray-900"><%= item.title %></div>
              <%= if item.description do %>
                <div class="text-xs text-gray-500 truncate max-w-xs"><%= item.description %></div>
              <% end %>
            </td>
            <td class="px-4 py-2 text-gray-900">
              <%= item.equipment_name %>
            </td>
            <td class="px-4 py-2 text-gray-900">
              <%= item.technician_name %>
            </td>
            <td class="px-4 py-2 text-gray-900">
              <%= format_duration(item.duration) %>
            </td>
            <td class="px-4 py-2">
              <span class={"inline-flex items-center px-2 py-0.5 rounded text-xs font-medium #{status_badge_color(item.status)}"}>
                <%= humanize_status(item.status) %>
              </span>
            </td>
            <td class="px-4 py-2 text-center">
              <button
                phx-click="view_detail"
                phx-value-id={item.reference_id}
                phx-value-type={item.type}
                class="text-blue-600 hover:text-blue-800 font-medium text-xs"
              >
                View
              </button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= if @total_count == 0 do %>
      <div class="flex items-center justify-center py-12">
        <div class="text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No history found</h3>
          <p class="mt-1 text-sm text-gray-500">Try adjusting your filters or search query.</p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <%= if @total_pages > 1 do %>
    <div class="flex items-center justify-between px-6 py-3 border-t border-gray-200 bg-white">
      <div class="flex items-center gap-2">
        <span class="text-sm text-gray-700">Per page:</span>
        <select
          phx-change="change_per_page"
          name="per_page"
          class="px-2 py-1 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="25" selected={@per_page == 25}>25</option>
          <option value="50" selected={@per_page == 50}>50</option>
          <option value="100" selected={@per_page == 100}>100</option>
        </select>
      </div>

      <div class="flex items-center gap-2">
        <button
          phx-click="change_page"
          phx-value-page={@page - 1}
          disabled={@page == 1}
          class="px-3 py-1 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Previous
        </button>

        <span class="text-sm text-gray-700">
          Page <%= @page %> of <%= @total_pages %>
        </span>

        <button
          phx-click="change_page"
          phx-value-page={@page + 1}
          disabled={@page == @total_pages}
          class="px-3 py-1 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Next
        </button>
      </div>
    </div>
  <% end %>
</div>

<script>
  // Auto-download export
  window.addEventListener("phx:download", (e) => {
    const { filename, content, mime_type } = e.detail;
    const blob = new Blob([content], { type: mime_type });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
  });
</script>
