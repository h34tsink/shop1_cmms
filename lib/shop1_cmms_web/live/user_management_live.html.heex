<div class="h-screen flex flex-col overflow-hidden bg-gray-50">
  <%= if @live_action == :index do %>
    <!-- Header -->
    <div class="border-b border-gray-200 px-6 py-3.5 bg-white">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-semibold text-gray-900">User Management</h1>
          <p class="text-xs text-gray-500 mt-0.5">Manage user access and roles for your tenant</p>
        </div>
        <div>
          <.link
            navigate={~p"/admin/users/new"}
            class="inline-flex items-center px-3.5 py-2 border border-transparent rounded text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm transition-colors"
          >
            <.icon name="hero-plus" class="h-4 w-4 mr-1.5" />
            Add User
          </.link>
        </div>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-gray-50 px-6 py-3 border-b border-gray-200">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Search -->
        <div>
          <.form for={%{}} phx-submit="search">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <.icon name="hero-magnifying-glass" class="h-4 w-4 text-gray-400" />
              </div>
              <input
                type="text"
                name="search[term]"
                value={@search_term}
                placeholder="Search by username..."
                phx-debounce="300"
                phx-change="search"
                class="w-full pl-10 pr-3 py-2 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
              />
            </div>
          </.form>
        </div>

        <!-- Role Filter -->
        <div>
          <select
            name="role"
            phx-change="filter_role"
            class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          >
            <%= for {label, value} <- @role_options do %>
              <option value={value} selected={@selected_role == value}>
                <%= label %>
              </option>
            <% end %>
          </select>
        </div>
      </div>
    </div>

    <!-- Users Table -->
    <div class="flex-1 overflow-auto bg-white">
      <%= if @loading do %>
        <div class="p-12 text-center">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <p class="mt-2 text-sm text-gray-500">Loading users...</p>
        </div>
      <% else %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 sticky top-0 z-10">
            <tr>
              <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                User
              </th>
              <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Role
              </th>
              <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Last Login
              </th>
              <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-48">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
          <tbody class="bg-white divide-y divide-gray-200">
            <%= for user <- @users do %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-2.5">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-9 w-9">
                      <div class="h-9 w-9 rounded-full bg-blue-100 flex items-center justify-center">
                        <span class="text-sm font-medium text-blue-700">
                          <%= String.first(user.username) |> String.upcase() %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-3">
                      <div class="text-sm font-medium text-gray-900">
                        <%= user.username %>
                      </div>
                      <div class="text-xs text-gray-500">
                        ID: <%= user.id %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-2.5">
                  <div class="flex gap-1.5">
                    <span class={"inline-flex px-2 py-0.5 text-xs font-medium rounded #{if user.is_active, do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800"}"}>
                      <%= if user.is_active, do: "Active", else: "Inactive" %>
                    </span>
                    <span class={"inline-flex px-2 py-0.5 text-xs font-medium rounded #{if user.cmms_enabled, do: "bg-blue-100 text-blue-800", else: "bg-gray-100 text-gray-600"}"}>
                      <%= if user.cmms_enabled, do: "CMMS", else: "No CMMS" %>
                    </span>
                  </div>
                </td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center gap-2">
                    <select
                      name="role"
                      phx-change="change_role"
                      phx-value-user_id={user.id}
                      class="text-sm border-gray-300 rounded focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                    >
                      <%= options_for_select(
                        @role_select_options, 
                        user.display_role_data.selected_role_id
                      ) %>
                    </select>
                    
                    <%= if user.display_role_data.has_pending_change do %>
                      <button
                        type="button"
                        phx-click="save_role_change"
                        phx-value-user_id={user.id}
                        class="inline-flex items-center p-1 border border-transparent text-xs font-medium rounded text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-green-500"
                        title="Save role change"
                      >
                        <.icon name="hero-check" class="h-3.5 w-3.5" />
                      </button>
                      <button
                        type="button"
                        phx-click="cancel_role_change"
                        phx-value-user_id={user.id}
                        class="inline-flex items-center p-1 border border-transparent text-xs font-medium rounded text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-red-500"
                        title="Cancel role change"
                      >
                        <.icon name="hero-x-mark" class="h-3.5 w-3.5" />
                      </button>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-2.5 text-sm text-gray-600">
                  <%= if user.last_cmms_login do %>
                    <%= Calendar.strftime(user.last_cmms_login, "%b %d, %Y") %>
                  <% else %>
                    <span class="text-gray-400">Never</span>
                  <% end %>
                </td>
                <td class="px-4 py-2.5 text-sm font-medium">
                  <div class="flex gap-3">
                    <%= if user.cmms_enabled do %>
                      <button
                        phx-click="disable_cmms"
                        phx-value-user_id={user.id}
                        data-confirm="Are you sure you want to disable CMMS access for this user?"
                        class="text-red-600 hover:text-red-800"
                      >
                        Disable CMMS
                      </button>
                    <% else %>
                      <button
                        phx-click="enable_cmms"
                        phx-value-user_id={user.id}
                        class="text-green-600 hover:text-green-800"
                      >
                        Enable CMMS
                      </button>
                    <% end %>
                    <.link
                      navigate={~p"/admin/users/#{user.id}/edit"}
                      class="text-blue-600 hover:text-blue-800"
                    >
                      Edit
                    </.link>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <%= if Enum.empty?(@users) do %>
          <div class="p-12 text-center bg-white">
            <.icon name="hero-users" class="h-12 w-12 text-gray-300 mx-auto mb-3" />
            <h3 class="text-base font-medium text-gray-900 mb-1">No users found</h3>
            <p class="text-sm text-gray-500 mb-4">
              <%= if @search_term != "" do %>
                No users match your search criteria.
              <% else %>
                Get started by adding a user to your tenant.
              <% end %>
            </p>
            <%= if @search_term == "" do %>
              <.link
                navigate={~p"/admin/users/new"}
                class="inline-flex items-center px-4 py-2 border border-transparent rounded text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 shadow-sm"
              >
                <.icon name="hero-plus" class="h-4 w-4 mr-1.5" />
                Add First User
              </.link>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
    
  <% else %>
    <!-- Form View -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <!-- Form Header -->
      <div class="border-b border-gray-200 px-6 py-3.5 bg-white">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-xl font-semibold text-gray-900"><%= @page_title %></h1>
            <p class="text-xs text-gray-500 mt-0.5">
              <%= if @live_action == :new do %>
                Add a new user to your tenant
              <% else %>
                Update user details and settings
              <% end %>
            </p>
          </div>
          <div>
            <.link
              navigate={~p"/admin/users"}
              class="inline-flex items-center px-3.5 py-2 border border-gray-300 rounded text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 shadow-sm transition-colors"
            >
              <.icon name="hero-arrow-left" class="h-4 w-4 mr-1.5" />
              Back to Users
            </.link>
          </div>
        </div>
      </div>

      <!-- User Form -->
      <div class="flex-1 overflow-auto bg-gray-50 p-6">
        <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-sm">
          <.form
            for={@form}
            phx-change="validate"
            phx-submit="save"
            class="p-6 space-y-6"
          >
            <!-- Basic Information -->
            <div>
              <h3 class="text-base font-semibold text-gray-900 mb-4">Basic Information</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <.input
                    field={@form[:username]}
                    type="text"
                    label="Username"
                    placeholder="Enter username"
                    required
                  />
                </div>

                <%= if @live_action == :new do %>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                      Initial Role
                    </label>
                    <select
                      name="user[role_id]"
                      class="w-full border border-gray-300 rounded shadow-sm py-2 px-3 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
                    >
                      <option value="">Select a role (optional)</option>
                      <%= for {display_name, role_id} <- Enum.drop(@role_options, 1) do %>
                        <option value={role_id}><%= display_name %></option>
                      <% end %>
                    </select>
                    <p class="mt-1.5 text-xs text-gray-500">
                      You can assign a role now or later from the user list
                    </p>
                  </div>
                <% end %>
              </div>
            </div>

            <%= if @live_action == :new do %>
              <!-- Password Section for New Users -->
              <div class="border-t border-gray-200 pt-6">
                <h3 class="text-base font-semibold text-gray-900 mb-4">Password Setup</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <.input
                      field={@form[:password]}
                      type="password"
                      label="Password"
                      placeholder="Enter secure password"
                      required
                    />
                  </div>
                  <div>
                    <.input
                      field={@form[:password_confirmation]}
                      type="password"
                      label="Confirm Password"
                      placeholder="Confirm password"
                      required
                    />
                  </div>
                </div>
                <div class="mt-3 p-3 bg-blue-50 border border-blue-100 rounded text-xs text-gray-700">
                  <p class="font-medium mb-1">Password requirements:</p>
                  <ul class="list-disc list-inside space-y-0.5">
                    <li>At least 12 characters long</li>
                    <li>At least one lowercase letter</li>
                    <li>At least one uppercase letter</li>
                    <li>At least one digit or punctuation character</li>
                  </ul>
                </div>
              </div>
            <% end %>

            <!-- Account Settings -->
            <div class="border-t border-gray-200 pt-6">
              <h3 class="text-base font-semibold text-gray-900 mb-4">Account Settings</h3>
              <div class="space-y-3">
                <div class="flex items-start">
                  <.input
                    field={@form[:is_active]}
                    type="checkbox"
                    label=""
                  />
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900">Account Active</p>
                    <p class="text-xs text-gray-500">Inactive users cannot log in</p>
                  </div>
                </div>
                <div class="flex items-start">
                  <.input
                    field={@form[:cmms_enabled]}
                    type="checkbox"
                    label=""
                  />
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900">CMMS Access Enabled</p>
                    <p class="text-xs text-gray-500">Allow access to CMMS features</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="flex justify-end gap-3 pt-6 border-t border-gray-200">
              <.link
                navigate={~p"/admin/users"}
                class="inline-flex items-center px-4 py-2 border border-gray-300 rounded text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 shadow-sm transition-colors"
              >
                Cancel
              </.link>
              <.button
                type="submit"
                class="inline-flex items-center px-4 py-2 border border-transparent rounded shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
              >
                <%= if @live_action == :new, do: "Create User", else: "Update User" %>
              </.button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  <% end %>
</div>