<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <%= if @live_action == :index do %>
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">User Management</h1>
            <p class="text-gray-600">Manage user access and roles for your tenant</p>
          </div>
          <div class="flex gap-3">
            <.link
              navigate={~p"/admin/users/new"}
              class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              <.icon name="hero-plus" class="h-4 w-4 mr-2" />
              Add User
            </.link>
          </div>
        </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-white rounded-lg shadow mb-6 p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Search -->
        <div>
          <label for="search" class="block text-sm font-medium text-gray-700 mb-2">
            Search Users
          </label>
          <.form for={%{}} phx-submit="search">
            <div class="relative">
              <input
                type="text"
                name="search[term]"
                value={@search_term}
                placeholder="Search by username..."
                phx-debounce="300"
                phx-change="search"
                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
              />
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <.icon name="hero-magnifying-glass" class="h-5 w-5 text-gray-400" />
              </div>
            </div>
          </.form>
        </div>

        <!-- Role Filter -->
        <div>
          <label for="role_filter" class="block text-sm font-medium text-gray-700 mb-2">
            Filter by Role
          </label>
          <select
            name="role"
            phx-change="filter_role"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
          >
            <%= for {label, value} <- @role_options do %>
              <option value={value} selected={@selected_role == value}>
                <%= label %>
              </option>
            <% end %>
          </select>
        </div>
      </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <%= if @loading do %>
        <div class="p-12 text-center">
          <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
          <p class="mt-2 text-sm text-gray-500">Loading users...</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  User
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Status
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Role
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Last Login
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <%= for user <- @users do %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-10 w-10">
                        <div class="h-10 w-10 rounded-full bg-gray-300 flex items-center justify-center">
                          <span class="text-sm font-medium text-gray-700">
                            <%= String.first(user.username) |> String.upcase() %>
                          </span>
                        </div>
                      </div>
                      <div class="ml-4">
                        <div class="text-sm font-medium text-gray-900">
                          <%= user.username %>
                        </div>
                        <div class="text-sm text-gray-500">
                          ID: <%= user.id %>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex flex-col gap-1">
                      <!-- Account Status -->
                      <span class={"inline-flex px-2 py-1 text-xs font-semibold rounded-full #{if user.is_active, do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800"}"}>
                        <%= if user.is_active, do: "Active", else: "Inactive" %>
                      </span>
                      <!-- CMMS Status -->
                      <span class={"inline-flex px-2 py-1 text-xs font-semibold rounded-full #{if user.cmms_enabled, do: "bg-blue-100 text-blue-800", else: "bg-gray-100 text-gray-800"}"}>
                        <%= if user.cmms_enabled, do: "CMMS Enabled", else: "CMMS Disabled" %>
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center space-x-2">
                      <select
                        name="role"
                        phx-change="change_role"
                        phx-value-user_id={user.id}
                        class="text-sm border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
                      >
                        <%= options_for_select(
                          @role_select_options, 
                          user.display_role_data.selected_role_id
                        ) %>
                      </select>
                      
                      <%= if user.display_role_data.has_pending_change do %>
                        <button
                          type="button"
                          phx-click="save_role_change"
                          phx-value-user_id={user.id}
                          class="inline-flex items-center px-2 py-1 border border-transparent text-xs font-medium rounded text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
                          title="Save role change"
                        >
                          <.icon name="hero-check" class="h-3 w-3" />
                        </button>
                        <button
                          type="button"
                          phx-click="cancel_role_change"
                          phx-value-user_id={user.id}
                          class="inline-flex items-center px-2 py-1 border border-transparent text-xs font-medium rounded text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
                          title="Cancel role change"
                        >
                          <.icon name="hero-x-mark" class="h-3 w-3" />
                        </button>
                      <% end %>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= if user.last_cmms_login do %>
                      <%= Calendar.strftime(user.last_cmms_login, "%b %d, %Y") %>
                    <% else %>
                      Never
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <div class="flex gap-2">
                      <%= if user.cmms_enabled do %>
                        <button
                          phx-click="disable_cmms"
                          phx-value-user_id={user.id}
                          data-confirm="Are you sure you want to disable CMMS access for this user?"
                          class="text-red-600 hover:text-red-900"
                        >
                          Disable CMMS
                        </button>
                      <% else %>
                        <button
                          phx-click="enable_cmms"
                          phx-value-user_id={user.id}
                          class="text-green-600 hover:text-green-900"
                        >
                          Enable CMMS
                        </button>
                      <% end %>
                      <.link
                        navigate={~p"/admin/users/#{user.id}/edit"}
                        class="text-blue-600 hover:text-blue-900 ml-4"
                      >
                        Edit
                      </.link>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <%= if Enum.empty?(@users) do %>
            <div class="p-12 text-center">
              <.icon name="hero-users" class="h-12 w-12 text-gray-400 mx-auto mb-4" />
              <h3 class="text-lg font-medium text-gray-900 mb-2">No users found</h3>
              <p class="text-gray-500 mb-4">
                <%= if @search_term != "" do %>
                  No users match your search criteria.
                <% else %>
                  Get started by adding a user to your tenant.
                <% end %>
              </p>
              <%= if @search_term == "" do %>
                <.link
                  navigate={~p"/admin/users/new"}
                  class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700"
                >
                  <.icon name="hero-plus" class="h-4 w-4 mr-2" />
                  Add First User
                </.link>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <% else %>
      <!-- Form Header -->
      <div class="mb-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl"><%= @page_title %></h1>
            <p class="text-gray-600">
              <%= if @live_action == :new do %>
                Add a new user to your tenant
              <% else %>
                Update user details and settings
              <% end %>
            </p>
          </div>
          <div class="flex gap-3">
            <.link
              navigate={~p"/admin/users"}
              class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
            >
              <.icon name="hero-arrow-left" class="h-4 w-4 mr-2" />
              Back to Users
            </.link>
          </div>
        </div>
      </div>

      <!-- User Form -->
      <div class="bg-white rounded-lg shadow">
        <.form
          for={@form}
          phx-change="validate"
          phx-submit="save"
          class="space-y-6 p-6"
        >
          <!-- Basic Information -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <.input
                field={@form[:username]}
                type="text"
                label="Username"
                placeholder="Enter username"
                required
              />
            </div>

            <%= if @live_action == :new do %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">
                  Initial Role
                </label>
                <select
                  name="user[role_id]"
                  class="w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                >
                  <option value="">Select a role (optional)</option>
                  <%= for {display_name, role_id} <- Enum.drop(@role_options, 1) do %>
                    <option value={role_id}><%= display_name %></option>
                  <% end %>
                </select>
                <p class="mt-1 text-sm text-gray-500">
                  You can assign a role now or later from the user list
                </p>
              </div>
            <% end %>
          </div>

          <%= if @live_action == :new do %>
            <!-- Password Section for New Users -->
            <div class="border-t pt-6">
              <h3 class="text-lg font-medium text-gray-900 mb-4">Password Setup</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <.input
                    field={@form[:password]}
                    type="password"
                    label="Password"
                    placeholder="Enter secure password"
                    required
                  />
                </div>
                <div>
                  <.input
                    field={@form[:password_confirmation]}
                    type="password"
                    label="Confirm Password"
                    placeholder="Confirm password"
                    required
                  />
                </div>
              </div>
              <div class="mt-3 text-sm text-gray-500">
                <p class="font-medium">Password requirements:</p>
                <ul class="list-disc list-inside mt-1 space-y-1">
                  <li>At least 12 characters long</li>
                  <li>At least one lowercase letter</li>
                  <li>At least one uppercase letter</li>
                  <li>At least one digit or punctuation character</li>
                </ul>
              </div>
            </div>
          <% end %>

          <!-- Account Settings -->
          <div class="border-t pt-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Account Settings</h3>
            <div class="space-y-4">
              <div class="flex items-center">
                <.input
                  field={@form[:is_active]}
                  type="checkbox"
                  label="Account Active"
                />
                <p class="ml-3 text-sm text-gray-500">
                  Inactive users cannot log in
                </p>
              </div>
              <div class="flex items-center">
                <.input
                  field={@form[:cmms_enabled]}
                  type="checkbox"
                  label="CMMS Access Enabled"
                />
                <p class="ml-3 text-sm text-gray-500">
                  Allow access to CMMS features
                </p>
              </div>
            </div>
          </div>

          <!-- Form Actions -->
          <div class="flex justify-end space-x-3 pt-6 border-t">
            <.link
              navigate={~p"/admin/users"}
              class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
            >
              Cancel
            </.link>
            <.button
              type="submit"
              class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
            >
              <%= if @live_action == :new, do: "Create User", else: "Update User" %>
            </.button>
          </div>
        </.form>
      </div>
    <% end %>
  </div>
</div>