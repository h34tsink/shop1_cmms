<div class="min-h-screen bg-gray-50 py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <%!-- Header with read-only indicator --%>
    <div class="bg-gradient-to-r from-gray-600 to-gray-700 rounded-lg shadow-lg p-6 mb-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <button
            phx-click="back_to_history"
            class="inline-flex items-center px-3 py-2 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to History
          </button>
          <div>
            <h1 class="text-3xl font-bold text-white"><%= @execution.execution_number %></h1>
            <p class="text-gray-200 mt-1">Completed PM Execution (Read-Only)</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class={"inline-flex items-center px-4 py-2 rounded-lg font-semibold text-sm #{status_badge_class(@execution.status)}"}>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <%= status_label(@execution.status) %>
          </span>
        </div>
      </div>
    </div>

    <%!-- Info Cards --%>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <%!-- Execution Date --%>
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Execution Date</p>
            <p class="text-lg font-semibold text-gray-900"><%= format_datetime(@execution.execution_date) %></p>
          </div>
        </div>
      </div>

      <%!-- Completed Date --%>
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Completed Date</p>
            <p class="text-lg font-semibold text-gray-900"><%= format_datetime(@execution.completed_date) %></p>
          </div>
        </div>
      </div>

      <%!-- Duration --%>
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-purple-500">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Duration</p>
            <p class="text-lg font-semibold text-gray-900"><%= format_duration(@execution.actual_duration_minutes) %></p>
          </div>
        </div>
      </div>
    </div>

    <%!-- Main Content --%>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <%!-- Left Column --%>
      <div class="lg:col-span-2 space-y-6">
        <%!-- PM Schedule Info --%>
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-900">PM Schedule Information</h3>
          </div>
          <div class="p-6 space-y-4">
            <%= if @execution.pm_schedule do %>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p class="text-sm font-medium text-gray-500">Schedule Title</p>
                  <p class="mt-1 text-sm text-gray-900"><%= @execution.pm_schedule.title %></p>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-500">Schedule Number</p>
                  <p class="mt-1 text-sm text-gray-900"><%= @execution.pm_schedule.schedule_number %></p>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-500">Frequency</p>
                  <p class="mt-1 text-sm text-gray-900">
                    Every <%= @execution.pm_schedule.frequency_value %>
                    <%= String.capitalize(to_string(@execution.pm_schedule.frequency_unit)) %>
                  </p>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-500">Priority</p>
                  <p class="mt-1 text-sm text-gray-900"><%= String.capitalize(to_string(@execution.pm_schedule.priority)) %></p>
                </div>
              </div>
              <div class="pt-4">
                <button
                  phx-click="view_schedule"
                  class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
                >
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  View PM Schedule
                </button>
              </div>
            <% else %>
              <p class="text-sm text-gray-500">PM schedule information not available</p>
            <% end %>
          </div>
        </div>

        <%!-- Work Instructions/Steps Completed --%>
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-900">Work Instructions Completed</h3>
          </div>
          <div class="p-6">
            <%= if @execution.step_results && length(@execution.step_results) > 0 do %>
              <div class="space-y-3">
                <%= for {step, index} <- Enum.with_index(@execution.step_results, 1) do %>
                  <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                    <div class="flex-shrink-0 mt-1">
                      <%= if step["completed"] do %>
                        <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                      <% else %>
                        <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                      <% end %>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-start justify-between">
                        <p class="text-sm font-medium text-gray-900">
                          <%= index %>. <%= step["instruction"] || step["step"] || "Step #{index}" %>
                        </p>
                        <span class={"inline-flex items-center px-2 py-1 rounded text-xs font-medium #{if step[" completed"], do: "bg-green-100 text-green-800", else: "bg-gray-100 text-gray-800"}"}>
                          <%= if step["completed"], do: "Completed", else: "Skipped" %>
                        </span>
                      </div>
                      <%= if step["notes"] do %>
                        <p class="mt-1 text-sm text-gray-600"><%= step["notes"] %></p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-gray-500">No work instructions recorded</p>
            <% end %>
          </div>
        </div>

        <%!-- Parts Used --%>
        <%= if @execution.parts_used && length(@execution.parts_used) > 0 do %>
          <div class="bg-white rounded-lg shadow border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
              <h3 class="text-lg font-semibold text-gray-900">Parts Used</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Part Number</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quantity</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <%= for part <- @execution.parts_used do %>
                    <tr>
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                        <%= part["part_number"] || "N/A" %>
                      </td>
                      <td class="px-6 py-4 text-sm text-gray-600">
                        <%= part["description"] || "N/A" %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                        <%= part["quantity"] || "N/A" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

        <%!-- Technician Notes --%>
        <%= if @execution.tech_notes do %>
          <div class="bg-white rounded-lg shadow border border-gray-200">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
              <h3 class="text-lg font-semibold text-gray-900">Technician Notes</h3>
            </div>
            <div class="p-6">
              <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= @execution.tech_notes %></p>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Right Column --%>
      <div class="space-y-6">
        <%!-- Equipment Info --%>
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-900">Equipment</h3>
          </div>
          <div class="p-6">
            <%= if @execution.asset do %>
              <div class="space-y-3">
                <div>
                  <p class="text-sm font-medium text-gray-500">Name</p>
                  <p class="mt-1 text-sm text-gray-900"><%= @execution.asset.name %></p>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-500">Number</p>
                  <p class="mt-1 text-sm text-gray-900"><%= @execution.asset.asset_number %></p>
                </div>
                <%= if @execution.component do %>
                  <div>
                    <p class="text-sm font-medium text-gray-500">Component</p>
                    <p class="mt-1 text-sm text-gray-900"><%= @execution.component.name %></p>
                  </div>
                <% end %>
                <%= if @execution.meter_reading do %>
                  <div>
                    <p class="text-sm font-medium text-gray-500">Meter Reading</p>
                    <p class="mt-1 text-sm text-gray-900"><%= @execution.meter_reading %></p>
                  </div>
                <% end %>
                <div class="pt-3">
                  <button
                    phx-click="view_equipment"
                    class="w-full inline-flex items-center justify-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    View Equipment
                  </button>
                </div>
              </div>
            <% else %>
              <p class="text-sm text-gray-500">Equipment information not available</p>
            <% end %>
          </div>
        </div>

        <%!-- Technician Info --%>
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-900">Technician</h3>
          </div>
          <div class="p-6">
            <%= if @execution.completed_by_user do %>
              <div class="flex items-center gap-3">
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center text-white font-semibold text-lg">
                    <%= String.first(@execution.completed_by_user.username || "?") %>
                  </div>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= @execution.completed_by_user.username %></p>
                  <p class="text-xs text-gray-500">Completed this PM</p>
                </div>
              </div>
            <% else %>
              <p class="text-sm text-gray-500">Technician information not available</p>
            <% end %>
          </div>
        </div>

        <%!-- Audit Info --%>
        <div class="bg-white rounded-lg shadow border border-gray-200">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
            <h3 class="text-lg font-semibold text-gray-900">Audit Information</h3>
          </div>
          <div class="p-6 space-y-3">
            <div>
              <p class="text-sm font-medium text-gray-500">Record ID</p>
              <p class="mt-1 text-xs text-gray-600 font-mono"><%= @execution.id %></p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Created At</p>
              <p class="mt-1 text-sm text-gray-900">
                <%= if @execution.inserted_at do %>
                  <%= Calendar.strftime(@execution.inserted_at, "%Y-%m-%d %H:%M") %>
                <% else %>
                  N/A
                <% end %>
              </p>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">Last Updated</p>
              <p class="mt-1 text-sm text-gray-900">
                <%= if @execution.updated_at do %>
                  <%= Calendar.strftime(@execution.updated_at, "%Y-%m-%d %H:%M") %>
                <% else %>
                  N/A
                <% end %>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
