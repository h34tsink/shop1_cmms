<div class="h-screen flex flex-col overflow-hidden bg-gray-50">
  <div class="flex flex-1 overflow-hidden">
    <!-- Sidebar -->
    <div class="w-64 bg-white shadow-sm border-r border-gray-200 flex flex-col">
      <div class="px-4 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-base font-semibold text-gray-900">Configuration</h2>
        <p class="text-xs text-gray-500 mt-0.5">System Settings</p>
      </div>
      
      <nav class="flex-1 px-2 py-3 space-y-0.5 overflow-y-auto">
        <%= for {type, config} <- [
          {"manufacturers", %{title: "Manufacturers", icon: "🏭"}},
          {"departments", %{title: "Departments", icon: "🏢"}},
          {"suppliers", %{title: "Suppliers", icon: "📦"}},
          {"priority_codes", %{title: "Priority Codes", icon: "⚡"}},
          {"maintenance_categories", %{title: "Categories", icon: "🔧"}},
          {"custom_fields", %{title: "Custom Fields", icon: "⚙️"}},
          {"asset_types", %{title: "Equipment Types", icon: "🏷️"}},
          {"asset_locations", %{title: "Equipment Locations", icon: "📍"}}
        ] do %>
          <.link
            navigate={~p"/configuration/#{type}"}
            class={[
              "flex items-center px-3 py-2 rounded text-sm font-medium transition-colors",
              if @metadata_type == type do
                "bg-blue-600 text-white shadow-sm"
              else
                "text-gray-700 hover:bg-gray-100"
              end
            ]}
          >
            <span class="mr-2.5 text-base"><%= config.icon %></span>
            <span class="flex-1"><%= config.title %></span>
          </.link>
        <% end %>
      </nav>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden bg-white">
      <!-- Header -->
      <div class="border-b border-gray-200 px-6 py-3.5 bg-white">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-xl font-semibold text-gray-900"><%= @metadata_config.title %></h1>
            <p class="text-xs text-gray-500 mt-0.5">Manage <%= String.downcase(@metadata_config.title) %> for your organization</p>
          </div>
          
          <button
            phx-click="new"
            class="inline-flex items-center px-3.5 py-2 border border-transparent rounded text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm transition-colors"
          >
            <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            New <%= @metadata_config.singular %>
          </button>
        </div>
      </div>

      <!-- Search Bar -->
      <div class="bg-gray-50 px-6 py-3 border-b border-gray-200">
        <.form :let={f} for={%{}} as={:search} phx-change="search" class="w-full max-w-md">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <.input
              field={f[:query]}
              value={@search_query}
              type="text"
              placeholder={"Search #{String.downcase(@metadata_config.title)}..."}
              class="block w-full pl-10 pr-3 py-2 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
        </.form>
      </div>

      <!-- Items Table -->
      <div class="flex-1 overflow-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 sticky top-0 z-10">
            <tr>
              <%= if @metadata_type in ["manufacturers", "departments", "suppliers"] do %>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <%= if @metadata_type == "suppliers" do %>
                  <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact</th>
                <% end %>
              <% end %>
              
              <%= if @metadata_type == "priority_codes" do %>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Color</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Response Time</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <%= if @metadata_type == "maintenance_categories" do %>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <%= if @metadata_type == "custom_fields" do %>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Entity</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Required</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <%= if @metadata_type == "asset_types" do %>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Color</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Features</th>
              <% end %>

              <%= if @metadata_type == "asset_locations" do %>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Address</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Area</th>
                <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <th class="relative px-4 py-2.5 w-32"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= for item <- @items do %>
              <tr class="hover:bg-gray-50">
                <%= if @metadata_type in ["manufacturers", "departments", "suppliers"] do %>
                  <td class="px-4 py-2.5 text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.description %>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class={[
                      "inline-flex px-2 py-0.5 text-xs font-medium rounded",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                  <%= if @metadata_type == "suppliers" do %>
                    <td class="px-4 py-2.5 text-sm text-gray-600">
                      <%= item.contact_email %>
                    </td>
                  <% end %>
                <% end %>

                <%= if @metadata_type == "priority_codes" do %>
                  <td class="px-4 py-2.5 text-sm font-medium text-gray-900">
                    <%= item.code %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.name %>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class="inline-flex items-center text-sm">
                      <span class="w-3 h-3 rounded-full mr-1.5" style={"background-color: #{item.color}"}></span>
                      <%= item.color %>
                    </span>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.sla_hours %> hours
                  </td>
                  <td class="px-4 py-2.5">
                    <span class={[
                      "inline-flex px-2 py-0.5 text-xs font-medium rounded",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <%= if @metadata_type == "maintenance_categories" do %>
                  <td class="px-4 py-2.5 text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= String.replace(to_string(item.type), "_", " ") |> String.capitalize() %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.description %>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class={[
                      "inline-flex px-2 py-0.5 text-xs font-medium rounded",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <%= if @metadata_type == "custom_fields" do %>
                  <td class="px-4 py-2.5 text-sm font-medium text-gray-900">
                    <%= item.field_name %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= String.replace(to_string(item.field_type), "_", " ") |> String.capitalize() %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= String.replace(to_string(item.entity_type), "_", " ") |> String.capitalize() %>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class={[
                      "inline-flex px-2 py-0.5 text-xs font-medium rounded",
                      if item.is_required do
                        "bg-red-100 text-red-800"
                      else
                        "bg-gray-100 text-gray-800"
                      end
                    ]}>
                      <%= if item.is_required, do: "Required", else: "Optional" %>
                    </span>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class={[
                      "inline-flex px-2 py-0.5 text-xs font-medium rounded",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <%= if @metadata_type == "asset_types" do %>
                  <td class="px-4 py-2.5 text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.code %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.category %>
                  </td>
                  <td class="px-4 py-2.5">
                    <%= if item.color do %>
                      <span class="inline-flex items-center text-sm">
                        <span class="w-3 h-3 rounded-full mr-1.5" style={"background-color: #{item.color}"}></span>
                        <%= item.color %>
                      </span>
                    <% else %>
                      <span class="text-gray-400 text-sm">-</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2.5 text-sm">
                    <div class="flex gap-1.5 flex-wrap">
                      <%= if item.has_meters do %>
                        <span class="inline-flex px-1.5 py-0.5 text-xs font-medium rounded bg-blue-100 text-blue-800">Meters</span>
                      <% end %>
                      <%= if item.has_components do %>
                        <span class="inline-flex px-1.5 py-0.5 text-xs font-medium rounded bg-green-100 text-green-800">Components</span>
                      <% end %>
                      <%= if not item.has_meters and not item.has_components do %>
                        <span class="text-gray-400">-</span>
                      <% end %>
                    </div>
                  </td>
                <% end %>

                <%= if @metadata_type == "asset_locations" do %>
                  <td class="px-4 py-2.5 text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= item.code %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= if item.address, do: String.slice(item.address, 0..40) <> if(String.length(item.address || "") > 40, do: "...", else: ""), else: "-" %>
                  </td>
                  <td class="px-4 py-2.5 text-sm text-gray-600">
                    <%= if item.area_size do %>
                      <%= Decimal.to_string(item.area_size, :normal) %> <%= item.area_unit %>
                    <% else %>
                      <span class="text-gray-400">-</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-2.5">
                    <span class={[
                      "inline-flex px-2 py-0.5 text-xs font-medium rounded",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <td class="px-4 py-2.5 text-right text-sm font-medium">
                  <div class="flex justify-end gap-3">
                    <button
                      phx-click="edit"
                      phx-value-id={item.id}
                      class="text-blue-600 hover:text-blue-800 font-medium"
                    >
                      Edit
                    </button>
                    <button
                      phx-click="delete"
                      phx-value-id={item.id}
                      data-confirm="Are you sure you want to delete this item?"
                      class="text-red-600 hover:text-red-800 font-medium"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>

            <%= if Enum.empty?(@items) do %>
              <tr>
                <td colspan="6" class="px-4 py-12 text-center text-gray-500">
                  <div class="flex flex-col items-center">
                    <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2"></path>
                    </svg>
                    <p class="text-base font-medium mb-1">No <%= String.downcase(@metadata_config.title) %> found</p>
                    <p class="text-sm text-gray-400">Get started by creating your first <%= String.downcase(@metadata_config.singular) %>.</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<%= if @show_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_modal">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
      <div class="fixed inset-0 transition-opacity" aria-hidden="true">
        <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
      </div>

      <div 
        class="inline-block align-middle bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:max-w-2xl sm:w-full"
        phx-click-away="close_modal"
      >
        <!-- Modal Header -->
        <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">
            <%= if @form_action == :new, do: "New", else: "Edit" %> <%= @metadata_config.singular %>
          </h3>
        </div>

        <!-- Modal Body -->
        <div class="bg-white px-6 py-4 max-h-[calc(100vh-16rem)] overflow-y-auto">
          <.form :let={f} for={@form} phx-submit="save" class="space-y-4">
            <%= render_form_fields(f, @metadata_type, @metadata_config) %>
            
            <!-- Modal Footer -->
            <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 mt-6">
              <button
                type="button"
                phx-click="close_modal"
                class="px-4 py-2 border border-gray-300 rounded text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="inline-flex justify-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
              >
                <%= if @form_action == :new, do: "Create", else: "Update" %>
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  </div>
<% end %>