<div class="h-full flex bg-gray-50">
  <!-- Sidebar -->
  <div class="w-64 bg-white shadow-lg">
    <div class="p-6 border-b">
      <h2 class="text-xl font-semibold text-gray-900">Metadata Management</h2>
    </div>
    
    <nav class="p-4 space-y-2">
      <%= for {type, config} <- [
        {"manufacturers", %{title: "Manufacturers", icon: "🏭"}},
        {"departments", %{title: "Departments", icon: "🏢"}},
        {"suppliers", %{title: "Suppliers", icon: "📦"}},
        {"priority_codes", %{title: "Priority Codes", icon: "⚡"}},
        {"maintenance_categories", %{title: "Categories", icon: "🔧"}},
        {"custom_fields", %{title: "Custom Fields", icon: "⚙️"}},
        {"asset_types", %{title: "Asset Types", icon: "🏷️"}},
        {"asset_locations", %{title: "Asset Locations", icon: "📍"}}
      ] do %>
        <.link
          navigate={~p"/metadata/#{type}"}
          class={[
            "flex items-center px-4 py-2 rounded-lg text-sm font-medium transition-colors",
            if @metadata_type == type do
              "bg-blue-50 text-blue-700 border border-blue-200"
            else
              "text-gray-600 hover:bg-gray-100 hover:text-gray-900"
            end
          ]}
        >
          <span class="mr-3 text-lg"><%= config.icon %></span>
          <%= config.title %>
        </.link>
      <% end %>
    </nav>
  </div>

  <!-- Main Content -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Header -->
    <div class="bg-white border-b px-6 py-4">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-semibold text-gray-900"><%= @metadata_config.title %></h1>
          <p class="text-sm text-gray-600 mt-1">Manage <%= String.downcase(@metadata_config.title) %> for your organization</p>
        </div>
        
        <button
          phx-click="new"
          class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          New <%= @metadata_config.singular %>
        </button>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-white px-6 py-4 border-b">
      <.form :let={f} for={%{}} as={:search} phx-change="search" class="flex items-center space-x-4">
        <div class="flex-1">
          <.input
            field={f[:query]}
            value={@search_query}
            type="text"
            placeholder={"Search #{String.downcase(@metadata_config.title)}..."}
            class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500"
          />
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </.form>
    </div>

    <!-- Items Table -->
    <div class="flex-1 overflow-auto p-6">
      <div class="bg-white shadow overflow-hidden sm:rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <%= if @metadata_type in ["manufacturers", "departments", "suppliers"] do %>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <%= if @metadata_type == "suppliers" do %>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact</th>
                <% end %>
              <% end %>
              
              <%= if @metadata_type == "priority_codes" do %>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Color</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Response Time</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <%= if @metadata_type == "maintenance_categories" do %>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <%= if @metadata_type == "custom_fields" do %>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Entity</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Required</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <%= if @metadata_type == "asset_types" do %>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Color</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Features</th>
              <% end %>

              <%= if @metadata_type == "asset_locations" do %>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Address</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Area</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <% end %>

              <th class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= for item <- @items do %>
              <tr class="hover:bg-gray-50">
                <%= if @metadata_type in ["manufacturers", "departments", "suppliers"] do %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.description %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={[
                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                  <%= if @metadata_type == "suppliers" do %>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= item.contact_email %>
                    </td>
                  <% end %>
                <% end %>

                <%= if @metadata_type == "priority_codes" do %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= item.code %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center">
                      <span class="w-3 h-3 rounded-full mr-2" style={"background-color: #{item.color}"}></span>
                      <%= item.color %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.sla_hours %> hours
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={[
                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <%= if @metadata_type == "maintenance_categories" do %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= String.replace(to_string(item.type), "_", " ") |> String.capitalize() %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.description %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={[
                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <%= if @metadata_type == "custom_fields" do %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= item.field_name %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= String.replace(to_string(item.field_type), "_", " ") |> String.capitalize() %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= String.replace(to_string(item.entity_type), "_", " ") |> String.capitalize() %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={[
                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                      if item.is_required do
                        "bg-red-100 text-red-800"
                      else
                        "bg-gray-100 text-gray-800"
                      end
                    ]}>
                      <%= if item.is_required, do: "Required", else: "Optional" %>
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={[
                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <%= if @metadata_type == "asset_types" do %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.code %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.category %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <%= if item.color do %>
                      <span class="inline-flex items-center">
                        <span class="w-3 h-3 rounded-full mr-2" style={"background-color: #{item.color}"}></span>
                        <%= item.color %>
                      </span>
                    <% else %>
                      <span class="text-gray-400">-</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <div class="flex space-x-2">
                      <%= if item.has_meters do %>
                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800">Meters</span>
                      <% end %>
                      <%= if item.has_components do %>
                        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Components</span>
                      <% end %>
                      <%= if not item.has_meters and not item.has_components do %>
                        <span class="text-gray-400">-</span>
                      <% end %>
                    </div>
                  </td>
                <% end %>

                <%= if @metadata_type == "asset_locations" do %>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= item.name %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= item.code %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= if item.address, do: String.slice(item.address, 0..50) <> if(String.length(item.address || "") > 50, do: "...", else: ""), else: "-" %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= if item.area_size do %>
                      <%= Decimal.to_string(item.area_size, :normal) %> <%= item.area_unit %>
                    <% else %>
                      <span class="text-gray-400">-</span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={[
                      "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                      if item.is_active do
                        "bg-green-100 text-green-800"
                      else
                        "bg-red-100 text-red-800"
                      end
                    ]}>
                      <%= if item.is_active, do: "Active", else: "Inactive" %>
                    </span>
                  </td>
                <% end %>

                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex justify-end space-x-2">
                    <button
                      phx-click="edit"
                      phx-value-id={item.id}
                      class="text-blue-600 hover:text-blue-900 text-sm"
                    >
                      Edit
                    </button>
                    <button
                      phx-click="delete"
                      phx-value-id={item.id}
                      data-confirm="Are you sure you want to delete this item?"
                      class="text-red-600 hover:text-red-900 text-sm ml-2"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>

            <%= if Enum.empty?(@items) do %>
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                  <div class="flex flex-col items-center">
                    <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2"></path>
                    </svg>
                    <p class="text-lg font-medium">No <%= String.downcase(@metadata_config.title) %> found</p>
                    <p class="text-sm">Get started by creating your first <%= String.downcase(@metadata_config.singular) %>.</p>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<%= if @show_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_modal">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 transition-opacity" aria-hidden="true">
        <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
      </div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div 
        class="inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6"
        phx-click-away="close_modal"
      >
        <div>
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
            <%= if @form_action == :new, do: "New", else: "Edit" %> <%= @metadata_config.singular %>
          </h3>

          <.form :let={f} for={@form} phx-submit="save" class="space-y-4">
            <%= render_form_fields(f, @metadata_type, @metadata_config) %>
            
            <div class="flex justify-end space-x-3 pt-4">
              <button
                type="button"
                phx-click="close_modal"
                class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
              >
                <%= if @form_action == :new, do: "Create", else: "Update" %>
              </button>
            </div>
          </.form>
        </div>
      </div>
    </div>
  </div>
<% end %>